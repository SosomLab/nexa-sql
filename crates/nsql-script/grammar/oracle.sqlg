# Oracle — ansi 위에 더한다(SQL Language Reference: SELECT · 계층 질의 · MERGE · PL/SQL 블록).
dialect = oracle
extends = ansi

[start]
next += MERGE INTO, EXEC, EXECUTE, BEGIN, DECLARE, SET SERVEROUTPUT ON, VARIABLE, PRINT, CREATE OR REPLACE, ALTER SESSION SET, ANALYZE, COMMENT ON

[statement SELECT]
clauses += CONNECT BY, START WITH, MINUS, MODEL, PIVOT, UNPIVOT

[clause SELECT]
next += ROWNUM, SYSDATE, SYSTIMESTAMP, LEVEL, CONNECT_BY_ROOT, NVL, DECODE, NVL2, LISTAGG, KEEP, DENSE_RANK, WITHIN GROUP, COLLATE
[clause FROM]
next += CONNECT BY, START WITH, MINUS, PIVOT, UNPIVOT, SAMPLE, PARTITION, SUBPARTITION, TABLE, LATERAL
[clause WHERE]
next += CONNECT BY, START WITH, MINUS, ROWNUM, PRIOR, FOR UPDATE, FOR UPDATE NOWAIT, COLLATE
[clause GROUP BY]
next += ROLLUP, CUBE, GROUPING SETS, MINUS
[clause HAVING]
next += MINUS, COLLATE
[clause ORDER BY]
next += NULLS FIRST, NULLS LAST, FOR UPDATE, COLLATE
[clause CONNECT BY]
next = PRIOR, NOCYCLE, LEVEL, START WITH, ORDER SIBLINGS BY, ORDER BY, GROUP BY
objects = column, function
[clause START WITH]
next = CONNECT BY, PRIOR, AND, OR
objects = column, function, subquery
[clause MINUS]
same = UNION
[clause SET]
next += RETURNING
[clause RETURNING]
next = INTO, BULK COLLECT INTO
objects = column
[clause CREATE]
next += OR REPLACE, PACKAGE, PACKAGE BODY, SYNONYM, PUBLIC SYNONYM, MATERIALIZED VIEW, GLOBAL TEMPORARY TABLE, DIRECTORY, TABLESPACE, COLLATE
[clause DROP]
next += PACKAGE, SYNONYM, MATERIALIZED VIEW, PURGE
[clause ALTER]
next += PACKAGE, PACKAGE BODY, SYNONYM, MATERIALIZED VIEW, SESSION SET, SYSTEM SET, TYPE
[clause ALTER TABLE]
next += MODIFY, ADD (, MODIFY (, DROP (, ENABLE CONSTRAINT, DISABLE CONSTRAINT, COLLATE
[clause ON]
next += COLLATE

# ★ T-200(10-30 · 82 §10-7 공식 문법 대조 ✅ 반영): 부모에서 물려받은 낱말 중 이 방언에 없는 것을 뺀다(`-=`).
[clause FROM]
next -= AS
[clause JOIN]
next -= AS
[clause WITH]
next -= RECURSIVE
[clause UNION]
next -= DISTINCT
[clause INSERT INTO]
next -= DEFAULT VALUES
[clause WHEN MATCHED]
next -= AND, THEN DELETE
[clause WHEN NOT MATCHED]
next -= AND
