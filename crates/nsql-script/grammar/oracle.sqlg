# Oracle — ansi 위에 더한다(SQL Language Reference: SELECT · 계층 질의 · MERGE · PL/SQL 블록).
dialect = oracle
extends = ansi

[start]
next += MERGE INTO, EXEC, EXECUTE, BEGIN, DECLARE, SET SERVEROUTPUT ON, VARIABLE, PRINT, CREATE OR REPLACE, ALTER SESSION SET, ANALYZE, COMMENT ON

[statement SELECT]
clauses += CONNECT BY, START WITH, MINUS, MODEL, PIVOT, UNPIVOT

[clause SELECT]
next += ROWNUM, SYSDATE, SYSTIMESTAMP, LEVEL, CONNECT_BY_ROOT, NVL, DECODE, NVL2, LISTAGG, KEEP, DENSE_RANK, WITHIN GROUP
[clause FROM]
next += CONNECT BY, START WITH, MINUS, PIVOT, UNPIVOT, SAMPLE, PARTITION, SUBPARTITION, TABLE, LATERAL, WHERE CURRENT OF
[clause WHERE]
next += CONNECT BY, START WITH, MINUS, ROWNUM, PRIOR, FOR UPDATE, FOR UPDATE NOWAIT, SKIP LOCKED
[clause GROUP BY]
next += ROLLUP, CUBE, GROUPING SETS, MINUS
[clause HAVING]
next += MINUS
[clause ORDER BY]
next += SIBLINGS, NULLS FIRST, NULLS LAST, FOR UPDATE
[clause CONNECT BY]
next = PRIOR, NOCYCLE, LEVEL, START WITH, ORDER SIBLINGS BY, ORDER BY, GROUP BY
objects = column, function
[clause START WITH]
next = CONNECT BY, PRIOR, AND, OR
objects = column, function, subquery
[clause MINUS]
same = UNION
[clause SET]
next += RETURNING, RETURNING INTO
[clause RETURNING]
next = INTO, BULK COLLECT INTO
objects = column
[clause CREATE]
next += OR REPLACE, PACKAGE, PACKAGE BODY, SYNONYM, PUBLIC SYNONYM, MATERIALIZED VIEW, GLOBAL TEMPORARY TABLE, DIRECTORY, TABLESPACE
[clause DROP]
next += PACKAGE, SYNONYM, MATERIALIZED VIEW, PURGE
