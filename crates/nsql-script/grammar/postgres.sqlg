# PostgreSQL — ansi 위에 더한다(LATERAL · ON CONFLICT · RETURNING · LIMIT/OFFSET · WINDOW).
dialect = postgres
extends = ansi

[start]
next += DO, COPY, VACUUM, ANALYZE, EXPLAIN ANALYZE, BEGIN, LISTEN, NOTIFY, CREATE OR REPLACE, CREATE EXTENSION, SET, SHOW, RESET, TRUNCATE TABLE

[statement SELECT]
clauses += LIMIT, OFFSET, WINDOW, FOR UPDATE, FOR SHARE

[clause SELECT]
next += ILIKE, ARRAY, COALESCE, NULLIF, NOW(), CURRENT_DATE, CURRENT_TIMESTAMP, FILTER, WITHIN GROUP, GREATEST, LEAST, ANY, ALL, SOME
[clause FROM]
next += LATERAL, TABLESAMPLE, ONLY, LIMIT, OFFSET, FOR UPDATE, FOR SHARE, WINDOW, UNNEST
[clause WHERE]
next += ILIKE, SIMILAR TO, LIMIT, OFFSET, RETURNING, FOR UPDATE, FOR SHARE, WINDOW, ANY, ALL, SOME, IS DISTINCT FROM
[clause GROUP BY]
next += ROLLUP, CUBE, GROUPING SETS, LIMIT, WINDOW
[clause HAVING]
next += LIMIT, WINDOW
[clause ORDER BY]
next += LIMIT, OFFSET, NULLS FIRST, NULLS LAST, USING, FOR UPDATE
[clause LIMIT]
next = OFFSET, ALL
[clause OFFSET]
next = ROWS, LIMIT, FETCH FIRST
[clause WINDOW]
next = AS, PARTITION BY, ORDER BY, ROWS BETWEEN, RANGE BETWEEN
objects = column
[clause INSERT INTO]
next += ON CONFLICT, RETURNING, OVERRIDING SYSTEM VALUE
[clause VALUES]
next += ON CONFLICT, RETURNING
[clause ON CONFLICT]
next = DO NOTHING, DO UPDATE SET, ON CONSTRAINT
objects = column
[clause SET]
next += RETURNING, FROM
[clause DELETE FROM]
next += USING, RETURNING
[clause WITH]
next += RECURSIVE, MATERIALIZED, NOT MATERIALIZED
[clause CREATE]
next += OR REPLACE, MATERIALIZED VIEW, EXTENSION, TYPE, DOMAIN, TEMP TABLE, UNLOGGED TABLE, INDEX CONCURRENTLY
[clause DROP]
next += MATERIALIZED VIEW, EXTENSION, TYPE, CASCADE
