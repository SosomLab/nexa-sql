# ClickHouse — ansi 위에 더한다(10-24 · 138차 · D-354): ENGINE · ORDER BY 키 · PARTITION BY · SETTINGS · FORMAT · PREWHERE · FINAL · SAMPLE ·
#   ARRAY JOIN · LIMIT BY · WITH TOTALS · ON CLUSTER · MATERIALIZED VIEW · TTL · KILL QUERY · SYSTEM · OPTIMIZE · ATTACH/DETACH · EXCHANGE · SHOW.
dialect = clickhouse
extends = ansi

[start]
next += SHOW TABLES, SHOW DATABASES, SHOW CREATE TABLE, SHOW PROCESSLIST, DESCRIBE TABLE, EXISTS TABLE, OPTIMIZE TABLE, SYSTEM, KILL QUERY, KILL MUTATION, ATTACH TABLE, DETACH TABLE, EXCHANGE TABLES, RENAME TABLE, CHECK TABLE, USE, SET, WATCH

[statement SELECT]
clauses += PREWHERE, ARRAY JOIN, LEFT ARRAY JOIN, SAMPLE, LIMIT BY, SETTINGS, FORMAT, WINDOW, LIMIT

[clause SELECT]
next += SETTINGS, FORMAT, ARRAY, TUPLE, MAP, EXTRACT, TO_DATE, TO_DATETIME, NOW, TODAY, COUNT, UNIQ, UNIQEXACT, ARGMAX, ARGMIN, GROUPARRAY, ARRAYJOIN, TOSTRING, TOINT32, TOINT64, TOFLOAT64, TODECIMAL64, TOUUID, FORMATDATETIME, DATEDIFF, DATETRUNC, MULTIIF, IF, IFNULL, COALESCE, LENGTH, LOWER, UPPER, CONCAT, SPLITBYCHAR, ARRAYMAP, ARRAYFILTER, ARRAYSUM, HAS, INDEXOF, POSITION, LIKE, ILIKE, MATCH, REPLACEALL, REPLACEREGEXPALL, TOSTARTOFDAY, TOSTARTOFMONTH, TOYYYYMM, GROUPARRAY, ARRAYSORT, ARRAYDISTINCT, ARRAYSLICE, ARRAYELEMENT, TUPLEELEMENT, JSONEXTRACT, JSONEXTRACTSTRING, VISITPARAMEXTRACTSTRING, QUANTILE, QUANTILES, MEDIAN, STDDEVPOP, VARPOP, CORR, SUMIF, COUNTIF, AVGIF, ANY, ANYLAST, TOPK, HISTOGRAM, ROUND, FLOOR, CEIL, ABS, MODULO, INTDIV, GREATEST, LEAST, RAND, GENERATEUUIDV4, HOSTNAME, VERSION, CURRENTDATABASE, CURRENTUSER
[clause FROM]
next += FINAL, SAMPLE, PREWHERE, ARRAY JOIN, LEFT ARRAY JOIN, ASOF JOIN, ANY JOIN, ALL JOIN, GLOBAL JOIN, SEMI JOIN, ANTI JOIN, LIMIT, SETTINGS, FORMAT, WINDOW
[clause PREWHERE]
next = AND, OR, NOT, IN, BETWEEN, LIKE, ILIKE, IS NULL, IS NOT NULL, WHERE, GROUP BY, ORDER BY, LIMIT, SETTINGS, FORMAT
objects = column, function, subquery
[clause ARRAY JOIN]
next = AS, WHERE, PREWHERE, GROUP BY, ORDER BY, LIMIT, SETTINGS, FORMAT
objects = column, function
[clause LEFT ARRAY JOIN]
same = ARRAY JOIN
[clause SAMPLE]
next = OFFSET, WHERE, PREWHERE, GROUP BY, ORDER BY, LIMIT
[clause WHERE]
next += ILIKE, MATCH, LIMIT, LIMIT BY, SETTINGS, FORMAT, WINDOW
[clause GROUP BY]
next += WITH TOTALS, WITH ROLLUP, WITH CUBE, LIMIT, LIMIT BY, SETTINGS, FORMAT
[clause HAVING]
next += LIMIT, LIMIT BY, SETTINGS, FORMAT
[clause ORDER BY]
next += LIMIT, OFFSET, LIMIT BY, SETTINGS, FORMAT, WITH FILL, COLLATE, NULLS FIRST, NULLS LAST
[clause LIMIT]
next = OFFSET, BY, WITH TIES, SETTINGS, FORMAT
[clause LIMIT BY]
next = LIMIT, SETTINGS, FORMAT
objects = column
[clause OFFSET]
next = SETTINGS, FORMAT
[clause SETTINGS]
next = FORMAT
[clause FORMAT]
next =
[clause WINDOW]
next = AS, PARTITION BY, ORDER BY, ROWS BETWEEN, RANGE BETWEEN
objects = column
[clause INSERT INTO]
next += VALUES, SELECT, FORMAT, SETTINGS
[clause CREATE]
next += TABLE IF NOT EXISTS, DATABASE, DATABASE IF NOT EXISTS, MATERIALIZED VIEW, VIEW, VIEW IF NOT EXISTS, DICTIONARY, FUNCTION, USER, ROLE, QUOTA, ROW POLICY, SETTINGS PROFILE, TEMPORARY TABLE, OR REPLACE TABLE
[clause ALTER]
next += TABLE, DATABASE, USER, ROLE
[clause DROP]
next += TABLE IF EXISTS, DATABASE, DATABASE IF EXISTS, VIEW, DICTIONARY, USER, ROLE, FUNCTION

# ★ T-200(10-30 · 82 §10-7 공식 문법 대조 ✅ 반영): 부모에서 물려받은 낱말 중 이 방언에 없는 것을 뺀다(`-=`).
[start]
next -= MERGE INTO, SAVEPOINT, DECLARE
[clause INSERT INTO]
next -= DEFAULT VALUES
[clause VALUES]
next -= RETURNING
[clause SET]
next -= RETURNING
[clause DELETE FROM]
next -= USING, RETURNING
