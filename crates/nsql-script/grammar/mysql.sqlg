# MySQL — ansi 위에 더한다(USE · SHOW · LIMIT · REPLACE · ON DUPLICATE KEY UPDATE · CALL)(10-01 ⑩ — 종전에는 파일이 없어 ansi로 떨어졌다).
dialect = mysql
extends = ansi

[start]
next += USE, SHOW TABLES, SHOW DATABASES, SHOW CREATE TABLE, DESCRIBE, EXPLAIN, REPLACE INTO, INSERT IGNORE INTO, CALL, SET, START TRANSACTION, LOCK TABLES, UNLOCK TABLES, TRUNCATE TABLE, RENAME TABLE

[statement SELECT]
clauses += LIMIT, OFFSET, FOR UPDATE, LOCK IN SHARE MODE

[clause SELECT]
next += SQL_CALC_FOUND_ROWS, STRAIGHT_JOIN, IFNULL, CONCAT, GROUP_CONCAT, DATE_FORMAT, NOW(), IF, COLLATE
[clause FROM]
next += STRAIGHT_JOIN, LIMIT, FOR UPDATE, LOCK IN SHARE MODE
[clause WHERE]
next += LIMIT, COLLATE
[clause ORDER BY]
next += LIMIT, COLLATE
[clause LIMIT]
next = OFFSET
[clause OFFSET]
next =
[clause INSERT INTO]
next += ON DUPLICATE KEY UPDATE
[clause VALUES]
next += ON DUPLICATE KEY UPDATE
[clause ON DUPLICATE KEY UPDATE]
objects = column, function
[clause UPDATE]
next += 
[clause DELETE FROM]
next += LIMIT
[clause CREATE]
next += TABLE IF NOT EXISTS, DATABASE, PROCEDURE, FUNCTION, TRIGGER, EVENT, COLLATE
[clause ALTER]
next += ADD COLUMN, DROP COLUMN, MODIFY COLUMN, CHANGE COLUMN, RENAME TO, ENGINE
[clause DROP]
next += DATABASE, PROCEDURE, FUNCTION, TRIGGER, EVENT
[clause ON]
next += COLLATE
[clause HAVING]
next += COLLATE
[clause ALTER TABLE]
next += COLLATE

# ★ T-200(10-30 · 82 §10-7 공식 문법 대조 ✅ 반영): 부모에서 물려받은 낱말 중 이 방언에 없는 것을 뺀다(`-=`).
[start]
next -= MERGE INTO
[clause FROM]
next -= FULL JOIN, FETCH FIRST, ROWS ONLY
[clause JOIN]
next -= FULL JOIN
[clause ON]
next -= FULL JOIN
[clause WHERE]
next -= FETCH FIRST, ROWS ONLY
[clause GROUP BY]
next -= FETCH FIRST
[clause HAVING]
next -= FETCH FIRST
[clause ORDER BY]
next -= FETCH FIRST, ROWS ONLY, NULLS FIRST, NULLS LAST, OFFSET, FETCH NEXT
[clause INSERT INTO]
next -= DEFAULT VALUES
[clause VALUES]
next -= RETURNING
[clause SET]
next -= RETURNING
[clause DELETE FROM]
next -= RETURNING
[clause UPDATE]
first = LOW_PRIORITY, IGNORE
