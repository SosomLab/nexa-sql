# SQLite — ansi 위에 더한다(PRAGMA · INSERT OR … · RETURNING · LIMIT/OFFSET · INDEXED BY).
dialect = sqlite
extends = ansi

[start]
next += PRAGMA, ATTACH DATABASE, DETACH DATABASE, VACUUM, REINDEX, ANALYZE, REPLACE INTO, INSERT OR REPLACE INTO, INSERT OR IGNORE INTO, BEGIN TRANSACTION, END TRANSACTION, CREATE TABLE IF NOT EXISTS, EXPLAIN QUERY PLAN

[statement SELECT]
clauses += LIMIT, OFFSET, WINDOW

[clause SELECT]
next += GLOB, IIF, COALESCE, IFNULL, TYPEOF, LENGTH, SUBSTR, STRFTIME, DATE, TIME, DATETIME, JULIANDAY
[clause FROM]
next += INDEXED BY, NOT INDEXED, LIMIT, WINDOW
[clause WHERE]
next += GLOB, REGEXP, MATCH, LIMIT, RETURNING, WINDOW, COLLATE
[clause GROUP BY]
next += LIMIT, WINDOW
[clause HAVING]
next += LIMIT, WINDOW
[clause ORDER BY]
next += LIMIT, COLLATE, NULLS FIRST, NULLS LAST
[clause LIMIT]
next = OFFSET
[clause OFFSET]
next =
[clause WINDOW]
next = AS, PARTITION BY, ORDER BY, ROWS BETWEEN, RANGE BETWEEN
objects = column
[clause INSERT INTO]
next += ON CONFLICT, RETURNING, DEFAULT VALUES
[clause VALUES]
next += ON CONFLICT, RETURNING
[clause ON CONFLICT]
next = DO NOTHING, DO UPDATE SET
objects = column
[clause SET]
next += RETURNING, FROM
[clause DELETE FROM]
next += RETURNING, LIMIT
[clause WITH]
next += RECURSIVE
[clause CREATE]
next += TABLE IF NOT EXISTS, VIRTUAL TABLE, TEMP TABLE, TEMPORARY TABLE, INDEX IF NOT EXISTS, UNIQUE INDEX IF NOT EXISTS, VIEW IF NOT EXISTS, TRIGGER IF NOT EXISTS
[clause DROP]
next += TABLE IF EXISTS, VIEW IF EXISTS, INDEX IF EXISTS, TRIGGER IF EXISTS

# ★ T-200(10-30 · 82 §10-7 공식 문법 대조 ✅ 반영): 부모에서 물려받은 낱말 중 이 방언에 없는 것을 뺀다(`-=`).
[start]
next -= MERGE INTO, GRANT, REVOKE, TRUNCATE TABLE, DESCRIBE, DECLARE
[clause FROM]
next -= FETCH FIRST, ROWS ONLY
[clause WHERE]
next -= FETCH FIRST, ROWS ONLY
[clause GROUP BY]
next -= FETCH FIRST
[clause HAVING]
next -= FETCH FIRST
[clause ORDER BY]
next -= FETCH FIRST, ROWS ONLY, OFFSET, FETCH NEXT
[clause DELETE FROM]
next -= USING
[clause UNION]
next -= DISTINCT
[clause CREATE]
next -= OR REPLACE, SEQUENCE, PROCEDURE, FUNCTION, SCHEMA, TYPE
[clause DROP]
next -= SEQUENCE, PROCEDURE, FUNCTION, SCHEMA, TYPE
[clause ALTER]
next -= VIEW, INDEX, SEQUENCE, TRIGGER, PROCEDURE, FUNCTION, SCHEMA
