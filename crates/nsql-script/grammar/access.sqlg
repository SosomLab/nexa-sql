# MS Access(Jet/ACE SQL) — ansi 위에 더한다(10-24 · 138차 · D-360): TOP n · DISTINCTROW · TRANSFORM/PIVOT · PARAMETERS · IIf/Nz/Format ·
#   `#날짜#` 리터럴 · `&` 연결 · `[이름]` 식별자 · INNER/LEFT/RIGHT JOIN만(FULL 없음) · LIMIT/OFFSET 없음 · UNION.
dialect = access
extends = ansi

[start]
next += TRANSFORM, PARAMETERS, SELECT DISTINCTROW, SELECT TOP, CREATE TABLE, ALTER TABLE, DROP TABLE, CREATE INDEX, DROP INDEX

[statement SELECT]
clauses += TOP, DISTINCTROW, PIVOT, TRANSFORM

[clause SELECT]
next += TOP, DISTINCTROW, IIF, NZ, FORMAT, NOW, DATE, TIME, DATEADD, DATEDIFF, DATEPART, DATESERIAL, DATEVALUE, YEAR, MONTH, DAY, WEEKDAY, HOUR, MINUTE, SECOND, LEN, LEFT, RIGHT, MID, INSTR, INSTRREV, LCASE, UCASE, LTRIM, RTRIM, TRIM, REPLACE, STRCONV, STRING, SPACE, CSTR, CINT, CLNG, CDBL, CCUR, CDATE, CBOOL, CVDATE, VAL, STR, INT, FIX, ROUND, ABS, SGN, SQR, RND, ISNULL, ISNUMERIC, ISDATE, SWITCH, CHOOSE, FIRST, LAST, STDEV, STDEVP, VAR, VARP, PARTITION, ASC, CHR, HEX, OCT
[clause TOP]
next = PERCENT, FROM, AS, DISTINCT
objects = column, function, subquery
[clause DISTINCTROW]
next = TOP, FROM, AS
objects = column, function, subquery
[clause FROM]
next += INNER JOIN, LEFT JOIN, RIGHT JOIN, IN, WHERE, GROUP BY, ORDER BY, PIVOT, WITH OWNERACCESS OPTION
[clause WHERE]
next += IIF, NZ, LIKE, NOT LIKE, BETWEEN, IN, IS NULL, IS NOT NULL, ALIKE, WITH OWNERACCESS OPTION
[clause GROUP BY]
next += PIVOT, WITH OWNERACCESS OPTION
[clause ORDER BY]
next += WITH OWNERACCESS OPTION
[clause TRANSFORM]
next = SELECT
objects = function, column
[clause PIVOT]
next = IN
objects = column, function
[clause PARAMETERS]
next = SELECT, TEXT, LONG, INTEGER, DOUBLE, DATETIME, CURRENCY, YESNO, BYTE, SINGLE
[clause INSERT INTO]
next += VALUES, SELECT, IN
[clause CREATE]
next += TABLE, INDEX, UNIQUE INDEX, VIEW, PROCEDURE
[clause ALTER]
next += TABLE
[clause DROP]
next += TABLE, INDEX, VIEW, PROCEDURE
