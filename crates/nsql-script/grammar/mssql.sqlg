# SQL Server(T-SQL) — ansi 위에 더한다(TOP · APPLY · OUTPUT · OFFSET FETCH · 배치 GO).
dialect = mssql
extends = ansi

[start]
next += EXEC, EXECUTE, GO, USE, DECLARE, SET, PRINT, IF, WHILE, BEGIN TRANSACTION, BEGIN TRY, RAISERROR, THROW, WITH (NOLOCK), MERGE INTO, BULK INSERT, TRUNCATE TABLE

[statement SELECT]
clauses += OFFSET, FETCH NEXT, CROSS APPLY, OUTER APPLY, OPTION

[clause SELECT]
next += TOP, INTO, GETDATE(), ISNULL, IIF, CONVERT, TRY_CONVERT, DATEADD, DATEDIFF, STRING_AGG, IDENTITY
[clause FROM]
next += WITH (NOLOCK), CROSS APPLY, OUTER APPLY, PIVOT, UNPIVOT, TABLESAMPLE, OFFSET, FETCH NEXT, OPTION
[clause CROSS APPLY]
same = JOIN
[clause OUTER APPLY]
same = JOIN
[clause WHERE]
next += OFFSET, OPTION
[clause ORDER BY]
next += OFFSET, FETCH NEXT, ROWS ONLY, OPTION
[clause OFFSET]
next = ROWS, ROW, FETCH NEXT, FETCH FIRST
[clause FETCH NEXT]
next = ROWS ONLY, ROW ONLY
[clause INSERT INTO]
next += OUTPUT, EXEC, DEFAULT VALUES
[clause SET]
next += OUTPUT, FROM
[clause UPDATE]
next += TOP
[clause DELETE FROM]
next += OUTPUT, TOP
[clause CREATE]
next += OR ALTER, CLUSTERED INDEX, NONCLUSTERED INDEX, LOGIN, USER, SYNONYM
[clause DROP]
next += SYNONYM, LOGIN, USER
