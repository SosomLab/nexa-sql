# SQL Server(T-SQL) — ansi 위에 더한다(TOP · APPLY · OUTPUT · OFFSET FETCH · 배치 GO).
dialect = mssql
extends = ansi

[start]
next += EXEC, EXECUTE, GO, USE, DECLARE, SET, PRINT, IF, WHILE, BEGIN TRANSACTION, BEGIN TRY, RAISERROR, THROW, MERGE INTO, BULK INSERT, TRUNCATE TABLE

[statement SELECT]
clauses += OFFSET, FETCH NEXT, CROSS APPLY, OUTER APPLY, OPTION

[clause SELECT]
next += TOP, INTO, GETDATE(), ISNULL, IIF, CONVERT, TRY_CONVERT, DATEADD, DATEDIFF, STRING_AGG, IDENTITY, COLLATE
first += TOP
[clause FROM]
next += WITH (NOLOCK), CROSS APPLY, OUTER APPLY, PIVOT, UNPIVOT, TABLESAMPLE, OPTION
[clause CROSS APPLY]
same = JOIN
[clause OUTER APPLY]
same = JOIN
[clause WHERE]
next += OPTION, COLLATE
[clause ORDER BY]
next += OFFSET, OPTION, COLLATE
[clause OFFSET]
next = ROWS, ROW, FETCH NEXT, FETCH FIRST
[clause FETCH NEXT]
next = ROWS ONLY, ROW ONLY
[clause INSERT INTO]
next += OUTPUT, EXEC, DEFAULT VALUES
[clause SET]
next += OUTPUT, FROM
[clause UPDATE]
next += TOP
[clause DELETE FROM]
next += OUTPUT
[clause CREATE]
next += OR ALTER, CLUSTERED INDEX, NONCLUSTERED INDEX, LOGIN, USER, SYNONYM, COLLATE
[clause DROP]
next += SYNONYM, LOGIN, USER
[clause ALTER TABLE]
next += ALTER COLUMN, WITH CHECK ADD CONSTRAINT, NOCHECK CONSTRAINT, CHECK CONSTRAINT, COLLATE
[clause ON]
next += COLLATE
[clause HAVING]
next += COLLATE

# ★ T-200(10-30 · 82 §10-7 공식 문법 대조 ✅ 반영): 부모에서 물려받은 낱말 중 이 방언에 없는 것을 뺀다(`-=`).
[start]
next -= SAVEPOINT, DESCRIBE, EXPLAIN
[clause FROM]
next -= FETCH FIRST, ROWS ONLY, USING, NATURAL JOIN
[clause JOIN]
next -= USING
[clause WHERE]
next -= FETCH FIRST, ROWS ONLY
[clause GROUP BY]
next -= FETCH FIRST
[clause HAVING]
next -= FETCH FIRST
[clause ORDER BY]
next -= FETCH FIRST, ROWS ONLY, NULLS FIRST, NULLS LAST
[clause FETCH FIRST]
next -= PERCENT ROWS ONLY, WITH TIES
[clause VALUES]
next -= RETURNING
[clause SET]
next -= RETURNING
[clause DELETE FROM]
next -= USING, RETURNING
[clause WITH]
next -= RECURSIVE
[clause UNION]
next -= DISTINCT
[clause CREATE]
next -= OR REPLACE
[clause ALTER TABLE]
next -= RENAME TO, RENAME COLUMN
